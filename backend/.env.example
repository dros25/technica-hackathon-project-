# Copy this file to backend/.env and fill in the values. Never commit the real .env.
# Share the real keys privately (a shared password-manager vault works well).

GEMINI_API_KEY=            # required for scene descriptions and naming (aistudio.google.com)
ELEVENLABS_API_KEY=        # optional - natural voice; without it the phone's own voice is used
OPENROUTER_API_KEY=        # optional - backup vision model if Gemini fails

# NGROK_DOMAIN=your-name.ngrok-free.app   # optional - fixed public link (start.bat uses it)
# WRIST_CAMERA=1                          # optional - USB webcam index for "point to ask"; off to disable
# MOCK_VISION=1                           # optional - fake descriptions, uses no API quota
# MOCK_HARDWARE=1                         # optional - run without the Arduino
# ARDUINO_PORT=COM3                       # optional - only if auto-detect picks the wrong USB port
# ARDUINO_HOST=172.20.10.4                # optional - wearable's Wi-Fi address (shown on its LCD); skips the search
# ELEVEN_VOICE_ID=...                     # optional - default voice (the app's voice picker overrides it)
